local function applyCharacterStats(char)
    if not char then return end
    local humanoid = char:WaitForChild("Humanoid", 5)
    if humanoid then
        if tbl.WalkSpeed then
            humanoid.WalkSpeed = tbl.WalkSpeed
            humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
                if humanoid.WalkSpeed ~= tbl.WalkSpeed then
                    humanoid.WalkSpeed = tbl.WalkSpeed
                end
            end)
        end
        if tbl.JumpPower then
            humanoid.JumpPower = tbl.JumpPower
        end
    end
end

