local function makeToggle(parent, text, callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0, 155, 0, 32)
    b.Text = text .. ": OFF"
    b.Font = Enum.Font.GothamBold
    b.TextSize = 11
    b.TextColor3 = Color3.fromRGB(200, 200, 205)
    b.BackgroundColor3 = PanelColor
    b.Parent = parent
    ApplyStyle(b, 5)
    
    local active = false
    b.MouseButton1Click:Connect(function()
        active = not active
        b.Text = text .. (active and ": ON" or ": OFF")
        b.TextColor3 = active and ThemeColor or Color3.fromRGB(200, 200, 205)
        callback(active)
    end)
    return b
end

