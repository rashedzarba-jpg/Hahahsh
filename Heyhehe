    for name, btn in pairs(tabButtons) do
        if name == tabName then
            TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = ThemeColor, TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
