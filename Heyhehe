makeToggle(pages.Visuals, "Dash Length", function(dashsh)
    tbl.DashEnabled = dashsh
    if dashsh then
        if DashConnection then task.cancel(DashConnection) end

        DashConnection = task.spawn(function()
            while tbl.DashEnabled do
                task.wait(0.1)
                local character = LocalPlayer.Character
                if character then
                    local currentValue = character:GetAttribute("DashLength")
                    if currentValue ~= tbl.DashLength then
                        character:SetAttribute("DashLength", tbl.DashLength)
                        character:SetAttribute("DashLengthAir", tbl.DashLength)
                    end
                end
            end
        end)
    else
        if DashConnection then
            local character = LocalPlayer.Character
            if character then
                character:SetAttribute("DashLength", 1)
                character:SetAttribute("DashLengthAir", 1)
            end
            task.cancel(DashConnection)
            DashConnection = nil
        end
    end
end)

